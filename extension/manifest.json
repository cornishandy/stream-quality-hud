{
  "manifest_version": 3,
  "name": "Stream Quality HUD",
  "version": "1.13.1",
  "description": "Shows current playback, streaming and disc data grades, and relevant playback issues. The corner pill names the size, codec and bitrate. Click it or press Control+Shift+H.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Stream Quality HUD (Control+Shift+H)",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "host_permissions": [
    "http://127.0.0.1:9791/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "hud.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
